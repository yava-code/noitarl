# ── Copy this file to .env and fill in your values ──────────────────────────
# .env is gitignored — never commit real tokens.

# ── Telegram bot ─────────────────────────────────────────────────────────────
# 1. Open @BotFather in Telegram → /newbot → copy the token
# 2. Send any message to your bot, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_EVERY=100000   # steps between notifications

# ── Weights & Biases ──────────────────────────────────────────────────────────
# Run: wandb login   (once per machine)
WANDB_ENABLED=false
WANDB_PROJECT=noitarl
WANDB_ENTITY=                  # your wandb username or team

# ── Training ──────────────────────────────────────────────────────────────────
TOTAL_TIMESTEPS=1000000
N_ENVS=1
NOITA_BASE_PORT=5001

# PPO hyperparams (leave blank for defaults)
LEARNING_RATE=0.0003
N_STEPS=2048
BATCH_SIZE=64
N_EPOCHS=10
GAMMA=0.99
GAE_LAMBDA=0.95
CLIP_RANGE=0.2

# ── Paths ─────────────────────────────────────────────────────────────────────
CHECKPOINT_DIR=./checkpoints
LOG_DIR=./logs
TENSORBOARD_DIR=./noita_ppo_tensorboard
